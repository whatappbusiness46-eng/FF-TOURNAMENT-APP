{
  "expo": {
    "name": "ZyroX Arena",
    "slug": "zyrox-arena",
    "version": "1.2.3",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/zyrox-arena-icon.png",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#080b10",
      "image": "./assets/zyrox-arena-logo.png"
    },
    "android": {
      "package": "com.zyroxarena.mobile2026",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/zyrox-arena-icon.png",
        "backgroundColor": "#080b10"
      }
    },
    "ios": {
      "bundleIdentifier": "com.zyroxarena.mobile2026"
    },
    "assetBundlePatterns": [
      "assets/*"
    ],
    "owner": "rifat5656",
    "extra": {
      "eas": {
        "projectId": "6c8f983c-1253-48b7-a4f7-aac19716a33d"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a",
              "x86",
              "x86_64"
            ]
          }
        }
      ]
    ]
  }
}
